# ═══════════════════════════════════════════════════════════════════════════
# EasyTier 全网拓扑 · 【唯一事实来源】
# ═══════════════════════════════════════════════════════════════════════════
# 这个文件不是“模块”，只是**一份纯数据**：它求值后得到一个「属性集」（可当字典）。
# 被上级的 easytier.nix 用 `import ./easytier-nodes.nix` 读走。
#
# 新增 / 迁移一台机器，通常只改这一个文件（再加那台 host 的两行，见 easytier.nix 顶部）。
#
# 【语法说明】
#  · 最外层 `{ ... }` 就是属性集本身（键 = 值 的集合）。
#  · `键 = 值;` 每一项都以分号结尾；键是标识符，值是字符串/数字/列表/又一层属性集。
#  · `[ "a" "b" ]` 是列表，元素之间用空格分隔（没有逗号）。
#  · `#` 开头是单行注释。
#
# 【约束】nodes 里的键名，必须与该机 my.easytier.node 完全一致；虚拟 IP 不能重复。
# ═══════════════════════════════════════════════════════════════════════════
{
  # EasyTier 的实例名 / 网络名（所有节点必须一致，等于“加入哪个网络”）
  network = "ctmiop";

  # 虚拟网段。模块会砍掉末尾的 ".0/24" 得到前缀 "10.144.144"，再拼各机 IP。
  cidr = "10.144.144.0/24";

  # ── 锚点（有公网入口、可被主动连进来的节点）──────────────────────────────
  # 其他节点的 peers 会自动指向这里的“全部锚点”。
  # 结构： 锚点名 = [ 它对外可达的 peer URL, ... ]   ← 值是“列表”，可放多个地址
  #   · 一个锚点可同时写 IPv4 与 IPv6（IPv6 地址要用方括号 [..] 包住，后面跟 :端口）
  #   · 每个锚点同时给 tcp 和 udp：udp 开销小、是打洞基础；tcp 更抗“封 UDP”的网络
  #   · 注意：aliyun 自己没有 IPv6，它连 lightsail 只能走 v4；lightsail 的 v6 那条
  #     是留给有公网 IPv6 的客户端（如手机）用的
  anchors = {
    aliyun = [
      "tcp://114.215.126.192:11010"
      "udp://114.215.126.192:11010"
    ];

    # lightsail（AWS 悉尼）：公网 v4 + 公网 v6，各给 tcp/udp。
    # 地址若在停机/重启后变化，要同步改这里；长期当锚点建议在控制台绑定静态 IP。
    lightsail = [
      "tcp://54.252.25.182:11010"
      "udp://54.252.25.182:11010"
      "tcp://[2406:da1c:803:3100:5d3e:e029:7a4a:f6c]:11010"
      "udp://[2406:da1c:803:3100:5d3e:e029:7a4a:f6c]:11010"
    ];
  };

  # ── 节点清单：节点名 = 虚拟 IP 的最后一段（十进制数字）────────────────────
  # 例如 aliyun = 1 表示 10.144.144.1；vostro-3420 = 2 表示 10.144.144.2。
  # 目前手机是 App（固定 10.144.144.3），不是 NixOS 机器，所以不进这张表。
  nodes = {
    aliyun = 1;
    vostro-3420 = 2;
    lightsail = 5;
  };
}
